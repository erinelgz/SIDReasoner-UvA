#!/bin/bash
#SBATCH --partition=genoa
#SBATCH --job-name=sasrec-ce-full
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --time=08:00:00
#SBATCH --output=slurm_output/%x-%j.out
#SBATCH --error=slurm_output/%x-%j.err

set -euo pipefail

SCRIPT_DIR="${SLURM_SUBMIT_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"
cd "$SCRIPT_DIR"
mkdir -p slurm_output

DATA_DIR="${DATA_DIR:-../SIDReasoner-UvA/data/Amazon}"

module purge
module load 2025
module load Anaconda3/2025.06-1

source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate recbole

export PYTHONUNBUFFERED=1
export PYTHONNOUSERSITE=1

echo "=== Step 1: Convert data to SASrec format ==="
python3 convert_data.py --data_dir "$DATA_DIR"

echo "=== Step 2: Run SASrec (CE loss + full ranking evaluation) ==="

DATASETS=(
    "Office_Products_5_2016-10-2018-11"
    "Industrial_and_Scientific_5_2016-10-2018-11"
    "Video_Games_5_2016-10-2018-11"
)

for DATASET in "${DATASETS[@]}"; do
    echo "--- Running SASrec on $DATASET ---"
    python3 main_torch.py \
        --dataset "$DATASET" \
        --train_dir ce_full \
        --maxlen 50 \
        --hidden_units 64 \
        --num_blocks 2 \
        --num_heads 1 \
        --dropout_rate 0.5 \
        --lr 0.001 \
        --batch_size 128 \
        --num_epochs 201 \
        --loss_type ce \
        --full_ranking
done

echo "=== Done ==="
